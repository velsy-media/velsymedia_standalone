---
import Phone from "../assets/Phone.png";
import Post from "../assets/Post.svg";
import Meta from "../assets/Meta.svg";
import { Image } from "astro:assets";
---

<div class="bg-white text-black py-12 px-4 md:px-12">
  <!-- Heading -->
  <div class="text-center mt-16">
    <h1 class="text-5xl font-bold">
      From viral
      <span
        class="custom-underline relative inline-block z-10 "
        style="text-decoration-color: #F56416;">social campaigns</span
      >
      <span class="block mt-4">
      to
      <span
        class="custom-underline relative inline-block z-10"
        style="text-decoration-color: #F56416;">brand storytelling</span
      >
      </span>
    </h1>
  </div>

  <!-- Grid Layout -->
 <div
  class="max-w-6xl mx-auto px-6 md:px-12 grid grid-cols-1 md:grid-cols-2 gap-16 mt-16"
>
  <!-- Left Column -->
  <div class="space-y-6">
    <h2 class="text-2xl font-semibold leading-tight mb-2">
      People remember<br />what they experience
    </h2>
    <p class="text-gray-700 mb-4">
      Creative guerrilla marketing, brand activations, hyperlocal ads, and
      experiential events for maximum impact and brand recall.
    </p>
    <Image src={Post} alt="Instagram UI" class="rounded-xl" />
  </div>

  <!-- Right Column -->
  <div class="space-y-6">
    <h2 class="text-2xl font-semibold leading-tight mb-2">
      Online Ads boost targeted reach, conversions, and ROI.
    </h2>
    <div class="flex space-x-3">
      <Image src={Meta} alt="Meta Logo" class="" />
    </div>
    <div class="space-y-2">
      <p class="font-semibold">
        #Hashtag strategy<br />A/B Testing and more…
      </p>
      <p class="text-gray-700">
        Boosting social media engagement with consistent posting, optimized
        timing, user-generated content, and interactive strategies.
      </p>
    </div>
  </div>
</div>

</div>

<section class="px-6 py-16" id="services">
  <div class="max-w-5xl mx-auto">
    <!-- Heading -->
    <div class="relative w-fit px-4">
  <h2 class="text-6xl md:text-5xl font-bold leading-snug">
    Your problem defines <br />
    <span class="custom-underline relative inline-block z-10">
