<style>
  .custom-underline::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: 0em; /* Adjust spacing from text */
  width: 100%;
  height: 8px; /* Thickness of underline */
  background-color: #F56416; /* Orange color */
  z-index: -1; /* Behind the text */
  border-radius: 2px; /* Optional: rounded ends */
}

</style>