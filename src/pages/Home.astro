<style>
  /* From Uiverse.io by kennyotsu-monochromia */
  .custom-bglines {
    width: 100%;
    height: 100%;
    --color: #e1e1e1;
    background-color: #f3f3f3;
    background-image: linear-gradient(
        0deg,
        transparent 24.5%,
        var(--color) 24.7%,
        var(--color) 25%,
        transparent 25.2%,
        transparent 74.5%,
        var(--color) 74.7%,
        var(--color) 75%,
        transparent 75.2%,
        transparent
      ),
      linear-gradient(
        90deg,
        transparent 24.5%,
        var(--color) 24.7%,
        var(--color) 25%,
        transparent 25.2%,
        transparent 74.5%,
        var(--color) 74.7%,
        var(--color) 75%,
        transparent 75.2%,
        transparent
      );
    background-size: 180px 180px; /* Increased grid size */
  }
</style>
<section id="home">
<div  class="text-black custom-bglines opacity-2 font-sans">
  <!-- Header -->
  <header class="flex justify-between items-center px-3 py-0">
    <img src="/logo.svg" alt="Velsy" />
    <div class="space-x-4 hidden md:flex">
      <button class="bg-black text-white px-4 py-2 rounded-md"
        >Make a Call</button
      >
      <button class="border border-black px-4 py-2 rounded-md"
        >Our Services</button
      >
    </div>

    <!-- Mobile Menu Button -->
    <div class="md:hidden">
      <button id="menu-toggle" class="text-3xl focus:outline-none">☰</button>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="absolute right-4 top-16 bg-white shadow-lg rounded-md p-4 hidden z-50"
    >
      <button class="block w-full text-left text-black mb-2">Make a Call</button
      >
      <button class="block w-full text-left text-black">Our Services</button>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="text-center px-6 md:px-20 mt-10">
    <h1 class="text-4xl md:text-6xl font-extrabold">
      <span class="relative z-30">
        REST EASY WHILE<br />
        WE TAKE CARE OF<br />
      </span>

      <span
        style="background-color:#F56416; line-height:1; padding:0 8px; display:inline-block; height:1.2em;"
        class="relative text-white z-20 align-middle"
      >
        YOUR DIGITAL
      </span>
      <br />
      <span
        style="background-color:#F56416; line-height:1; padding:0 8px; display:inline-block; height:1.3em;"
        class="relative text-white z-20 align-middle"
      >
        PRESENCE.
      </span>
    </h1>

    <!-- Illustrations (Replace with actual images if needed) -->
    <div
      style="background-image: url('/Chart.svg');"
      class="flex custom-bg justify-center items-center"
    >
      <div class="flex justify-center mt-8 mb-6"></div>
    </div>
    <div
      class=" rounded-full z-50 p-1 mt-8 scroll-smooth flex space-x-4 navbar"
    >
      <a
        href="#home"
        class="nav-item bg-black scroll-smooth text-white px-4 py-2 rounded-full"
        >Home</a
      >
      <a href="#services" class="nav-item px-4 py-2 scroll-smooth rounded-full"
        >Services</a
      >
      <a
        href=""
        class="nav-item lg:px-4 lg:py-2 sm:px-1 sm:py-2 text-sm md:text-base lg:text-lg rounded-full scroll-smooth"
        >Contact Us</a
      >
    </div>
  </section>
</div>
</section>
<style>
  .custom-bg {
    background-image: url("/Chart.svg");
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center -70px; /* pushes the image up */
    min-height: 450px;
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-20px);
    }

    100% {
      transform: translateY(0);
    }
  }
  .navbar {
    position: fixed;
    bottom: 70px; /* Adjust based on desired vertical placement */
    left: 50%;
     background: rgba(251, 251, 251, 0.95);
    transform: translateX(-50%);
    display: flex; /* Light background, optional */
    border-radius: 50px;
    scroll-behavior: smooth;
    justify-content: center; 
     align-items: center; 
     min-width: 350px;               /* Set a minimum width */
  min-height: 64px;  
  }
</style>

<script>
  // Get all nav items
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  if (toggle) {
    toggle.addEventListener("click", () => {
      if (menu) {
        menu.classList.toggle("hidden");
      }
    });
  }
  const navItems = document.querySelectorAll(".nav-item");
  const sections = document.querySelectorAll("section");

  window.addEventListener("scroll", () => {
    let currentSection: string | null = null;

    sections.forEach((section) => {
      const rect = section.getBoundingClientRect();
      if (rect.top <= 150 && rect.bottom >= 150) {
        currentSection = section.getAttribute("id");
      }
    });

    navItems.forEach((item) => {
      const hrefAttr = item.getAttribute("href");
      const href = hrefAttr ? hrefAttr.substring(1) : "";
      if (href === currentSection) {
        item.classList.add("bg-black", "text-white");
      } else {
        item.classList.remove("bg-black", "text-white");
      }
    });
  });
</script>
