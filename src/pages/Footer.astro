---

---

<footer
  style="background-color: #252525;"
  class="text-gray-400 overflow-x-hidden px-14 py-12"
>
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8">
    <!-- Company Info -->
    <div>
      <div class="flex items-center space-x-2 mb-3">
        <img src="/logo.svg" alt="Velsy" />
      </div>
      <p class="text-sm">
        Your trusted partner for digital<br />
        marketing and creative solutions in <br />Chennai.
      </p>
    </div>

    <!-- Services -->
    <div>
      <h4 class="text-white font-semibold mb-3">Services</h4>
      <ul class="space-y-2 text-sm">
        <li>Brand Management</li>
        <li>Social Media Marketing</li>
        <li>Software Solutions</li>
        <li>Graphic Design</li>
      </ul>
    </div>

    <!-- Quick Links -->
    <div>
      <h4 class="text-white font-semibold mb-3">Quick Links</h4>
      <ul class="space-y-2 text-sm">
        <li>About Us</li>
        <li>Our Work</li>
        <li>Contact</li>
        <li>Blog</li>
      </ul>
    </div>

    <!-- Newsletter -->
    <div>
      <h4 class="text-white font-semibold mb-3">Newsletter</h4>
      <p class="text-sm mb-3">
        Subscribe to our newsletter for updates and insights.
      </p>
      <div class="flex">
        <input
          type="email"
          placeholder="Your email"
          class="px-3 py-2 rounded-l-md bg-[#111827] border border-gray-600 text-white text-sm focus:outline-none focus:ring-1 focus:ring-orange-500"
        />
        <button
          style="background-color:#F56416;"
          class="bg-orange-500 text-white px-4 py-2 rounded-r-md text-sm"
          >Subscribe</button
        >
      </div>
    </div>
  </div>

  <div
    class="max-w-7xl mx-auto mt-10 border-t border-gray-700 pt-6 flex flex-col md:flex-row justify-between items-center text-sm text-gray-500"
  >
    <p>© 2024 Velsy Media. All rights reserved.</p>
    <div class="flex space-x-4 mt-4 md:mt-0 text-white text-lg">
      <a href="#" class="hover:text-white-500"
        ><i class="fab fa-facebook-f"></i></a
      >
      <a href="#" class="hover:text-orange-500"
        ><i class="fab fa-twitter"></i></a
      >
      <a href="#" class="hover:text-orange-500"
        ><i class="fab fa-instagram"></i></a
      >
      <a href="#" class="hover:text-orange-500"
        ><i class="fab fa-linkedin-in"></i></a
      >
    </div>
  </div>
</footer>
